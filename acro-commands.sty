\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{acro-commands}[2026/06/03 Custom acronym commands for acro]

\RequirePackage{acro}

\newcommand{\acfi}[1]{\acf[format/long=\itshape]{#1}}
\newcommand{\Acfi}[1]{\Acf[format/long=\itshape]{#1}}
\newcommand{\acfb}[1]{\acf[format/long=\bfseries]{#1}}
\newcommand{\Acfb}[1]{\Acf[format/long=\bfseries]{#1}}
\newcommand{\iacfi}[1]{\iacf[format/long=\itshape]{#1}}
\newcommand{\Iacfi}[1]{\Iacf[format/long=\itshape]{#1}}
\newcommand{\iacfb}[1]{\iacf[format/long=\bfseries]{#1}}
\newcommand{\Iacfb}[1]{\Iacf[format/long=\bfseries]{#1}}
