  file = {/Users/francescomarchisotti/Zotero/storage/FSYCXLRT/Koh et al. - 2020 - Concept Bottleneck Models.pdf;/Users/francescomarchisotti/Zotero/storage/PUPFYYGT/Koh et al. - 2020 - Concept Bottleneck Models.pdf}
