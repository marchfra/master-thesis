@inproceedings{wuCausalProxyModels2023,
  title = {Causal {{Proxy Models}} for {{Concept-based Model Explanations}}},
  booktitle = {Proceedings of the 40th {{International Conference}} on {{Machine Learning}}},
  author = {Wu, Zhengxuan and D'Oosterlinck, Karel and Geiger, Atticus and Zur, Amir and Potts, Christopher},
  year = 2023,
  month = jul,
  pages = {37313--37334},
  publisher = {PMLR},
  issn = {2640-3498},
  url = {https://proceedings.mlr.press/v202/wu23b.html},
  urldate = {2026-06-01},
  abstract = {Explainability methods for NLP systems encounter a version of the fundamental problem of causal inference: for a given ground-truth input text, we never truly observe the counterfactual texts necessary for isolating the causal effects of model representations on outputs. In response, many explainability methods make no use of counterfactual texts, assuming they will be unavailable. In this paper, we show that robust causal explainability methods can be created using approximate counterfactuals, which can be written by humans to approximate a specific counterfactual or simply sampled using metadata-guided heuristics. The core of our proposal is the Causal Proxy Model (CPM). A CPM explains a black-box model NN\textbackslash mathcal\textbraceleft N\textbraceright{} because it is trained to have the same actual input/output behavior as NN\textbackslash mathcal\textbraceleft N\textbraceright{} while creating neural representations that can be intervened upon to simulate the counterfactual input/output behavior of NN\textbackslash mathcal\textbraceleft N\textbraceright. Furthermore, we show that the best CPM for NN\textbackslash mathcal\textbraceleft N\textbraceright{} performs comparably to NN\textbackslash mathcal\textbraceleft N\textbraceright{} in making factual predictions, which means that the CPM can simply replace NN\textbackslash mathcal\textbraceleft N\textbraceright, leading to more explainable deployed models.},
  langid = {english},
  file = {/Users/francescomarchisotti/Zotero/storage/65ZITY8R/Wu et al. - 2023 - Causal Proxy Models for Concept-based Model Explanations.pdf}
}

